# Tuning MySQL 8 untuk VPS 2 vCPU / 4 GB RAM (mLITE Rizki Medika)
[mysqld]
# syarat mLITE/Khanza
sql_mode = ""
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-time-zone = "+07:00"

# memori: sekitar 1/4 RAM untuk InnoDB (PHP-FPM, nginx, OS butuh sisanya)
innodb_buffer_pool_size = 1G
innodb_redo_log_capacity = 512M
innodb_flush_log_at_trx_commit = 1
innodb_file_per_table = 1
max_connections = 80
tmp_table_size = 32M
max_heap_table_size = 32M
table_open_cache = 2000

# hanya di jaringan docker internal; tidak pernah di-publish ke internet
skip-name-resolve
bind-address = 0.0.0.0

# log query lambat untuk evaluasi performa
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2
