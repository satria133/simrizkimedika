# Salin menjadi docker/.env.production lalu isi semua nilai <...>.
#   cp .env.production.example .env.production && chmod 600 .env.production
# JANGAN commit .env.production ke git.

# Domain yang DNS A-record-nya sudah mengarah ke IP VPS (uji lokal: localhost)
DOMAIN=<rizkimedika.aisatira.web.id>
ACME_EMAIL=<email-admin@rizkimedika.id>

# Database (container mysql internal, tidak terbuka ke internet)
DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mlite_db
DB_USERNAME=mlite
# buat dengan: openssl rand -base64 24
DB_PASSWORD=<password-panjang-acak>
DB_ROOT_PASSWORD=<password-root-panjang-acak-berbeda>

COMPOSE_PROFILES=mysql_enabled

# yes = VPS bersama (nginx host + certbot sudah ada); no = VPS khusus (pakai Caddy)
SHARED_HOST=no
# port lokal container nginx (hanya untuk SHARED_HOST=yes)
APP_LOCAL_PORT=8200

# Backup offsite (dipakai backup.sh; remote rclone yang sudah dikonfigurasi, mis. "s3klinik:rizkimedika-backup")
# kosongkan bila belum ada object storage (backup hanya lokal)
BACKUP_REMOTE=
# passphrase enkripsi backup (simpan juga di tempat aman di luar server!)
BACKUP_PASSPHRASE=<passphrase-panjang-acak>
